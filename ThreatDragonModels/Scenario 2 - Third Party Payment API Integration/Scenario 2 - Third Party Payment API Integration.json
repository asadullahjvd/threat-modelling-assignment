              "type": "tm.Process",
              "name": "Frontend",
              "description": "Customer-facing web interface displaying products and transaction results",
              "outOfScope": false,
              "threats": [
                {
                  "id": "threat-1",
                  "title": "Cross-Site Scripting on Payment Page",
                  "type": "Tampering",
                  "status": "Open",
                  "severity": "High",
                  "description": "An attacker injects malicious scripts into the frontend payment page to steal customer payment details or session cookies.",
                  "mitigation": "Implement Content Security Policy (CSP), sanitise all user inputs, and use output encoding. Apply OWASP Top 10 A03 controls.",
                  "modelType": "STRIDE"
                }
              ]
            }
          },
          {
            "type": "tm.Process",
            "size": { "width": 100, "height": 100 },
            "position": { "x": 500, "y": 140 },
            "attrs": { "text": { "text": "E-commerce Backend" } },
            "shape": "process",
            "id": "process-backend",
            "zIndex": 2,
            "data": {
              "type": "tm.Process",
              "name": "E-commerce Backend",
              "description": "Core backend processing orders and communicating with payment gateway via REST API",
              "outOfScope": false,
              "threats": [
                {
                  "id": "threat-2",
                  "title": "API Key Theft and Misuse",
                  "type": "Spoofing",
                  "status": "Open",
                  "severity": "High",
                  "description": "An attacker gains access to the API key used to authenticate with the payment gateway, making unauthorised payment requests.",
                  "mitigation": "Store API keys in environment variables or secrets manager. Rotate keys regularly and restrict permissions to minimum scope.",
                  "modelType": "STRIDE"
                },
                {
                  "id": "threat-3",
                  "title": "Transaction Data Tampering",
                  "type": "Tampering",
                  "status": "Open",
                  "severity": "High",
                  "description": "An attacker intercepts and modifies transaction data in transit between the backend and payment gateway, altering payment amounts.",
                  "mitigation": "Use TLS 1.2+ for all API communications. Implement request signing and HMAC verification.",
                  "modelType": "STRIDE"
                },
                {
                  "id": "threat-4",
                  "title": "Transaction Repudiation",
                  "type": "Repudiation",
                  "status": "Open",
                  "severity": "Medium",
                  "description": "A customer or internal actor denies having made or processed a transaction. Without proper logging it is impossible to prove what actions were taken.",
                  "mitigation": "Implement comprehensive transaction audit logs with timestamps and transaction IDs stored in a tamper-evident system. Reference ISO 27001 A.12.4.",
                  "modelType": "STRIDE"
                }
              ]
            }
          },
          {
            "type": "tm.Store",
            "size": { "width": 130, "height": 60 },
            "position": { "x": 490, "y": 350 },
            "attrs": { "text": { "text": "Transaction Database" } },
