            "data": {
              "type": "tm.Actor",
              "name": "Email Service",
              "description": "Third-party email delivery service used to send order confirmation emails to customers",
              "outOfScope": false,
              "threats": [
                {
                  "id": "threat-6",
                  "title": "Email Service Compromise for Phishing",
                  "type": "Elevation of privilege",
                  "status": "Open",
                  "severity": "High",
                  "description": "An attacker compromises the third-party email service credentials or API key, allowing them to send fraudulent order confirmation emails containing phishing links to customers, escalating from email access to customer account takeover.",
                  "mitigation": "Use dedicated email API keys with send-only permissions. Implement DKIM, SPF, and DMARC email authentication. Monitor for anomalous sending patterns.",
                  "modelType": "STRIDE"
                }
              ]
            }
          },
