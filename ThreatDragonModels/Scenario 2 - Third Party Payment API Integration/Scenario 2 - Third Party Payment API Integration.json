            "zIndex": 2,
            "data": {
              "type": "tm.Process",
              "name": "Frontend",
              "description": "Customer-facing web interface displaying products and transaction results",
              "outOfScope": false,
              "threats": [
                {
                  "id": "threat-1",
                  "title": "Cross-Site Scripting (XSS) on Payment Page",
                  "type": "Tampering",
                  "status": "Open",
                  "severity": "High",
                  "description": "An attacker injects malicious scripts into the frontend payment page to steal customer payment details or session cookies before they are sent to the backend.",
                  "mitigation": "Implement Content Security Policy (CSP), sanitise all user inputs, and use output encoding. Apply OWASP Top 10 A03 controls.",
                  "modelType": "STRIDE"
                }
              ]
            }
          },
          {
            "type": "tm.Process",
            "size": { "width": 100, "height": 100 },
            "position": { "x": 500, "y": 130 },
            "attrs": {
              "text": { "text": "E-commerce Backend" }
            },
            "shape": "process",
            "id": "process-backend",
            "zIndex": 2,
            "data": {
              "type": "tm.Process",
              "name": "E-commerce Backend",
              "description": "Core backend service processing orders and communicating with payment gateway via REST API using API keys",
              "outOfScope": false,
              "threats": [
                {
                  "id": "threat-2",
                  "title": "API Key Theft and Misuse",
                  "type": "Spoofing",
                  "status": "Open",
                  "severity": "High",
                  "description": "An attacker gains access to the API key used to authenticate with the payment gateway, allowing them to make unauthorised payment requests or extract transaction data while impersonating the legitimate platform.",
                  "mitigation": "Store API keys in environment variables or a secrets manager, never in source code. Rotate keys regularly and restrict key permissions to minimum required scope.",
                  "modelType": "STRIDE"
                },
                {
                  "id": "threat-3",
                  "title": "Transaction Data Tampering",
                  "type": "Tampering",
                  "status": "Open",
                  "severity": "High",
                  "description": "An attacker intercepts or modifies transaction data in transit between the backend and payment gateway, altering payment amounts or redirecting funds.",
                  "mitigation": "Use TLS 1.2+ for all API communications, implement request signing/HMAC verification, and validate all transaction responses from the gateway.",
                  "modelType": "STRIDE"
                },
                {
                  "id": "threat-4",
                  "title": "Transaction Repudiation",
                  "type": "Repudiation",
                  "status": "Open",
                  "severity": "Medium",
                  "description": "A customer or internal actor denies having made or processed a transaction. Without proper logging, it is impossible to prove what actions were taken.",
                  "mitigation": "Implement comprehensive transaction audit logs with timestamps, user IDs, and transaction IDs. Store logs in a tamper-evident system. Reference ISO 27001 A.12.4.",
                  "modelType": "STRIDE"
                }
              ]
            }
          },
          {
            "type": "tm.Store",
            "size": { "width": 130, "height": 60 },
            "position": { "x": 480, "y": 340 },
