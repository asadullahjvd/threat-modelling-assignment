            "data": {
              "type": "tm.Store",
              "name": "Transaction Database",
              "description": "Internal database storing transaction results and customer order details",
              "outOfScope": false,
              "isALog": false,
              "storesCredentials": false,
              "isEncrypted": false,
              "threats": [
                {
                  "id": "threat-5",
                  "title": "Customer Payment Data Exposure",
                  "type": "Information disclosure",
                  "status": "Open",
                  "severity": "High",
                  "description": "Sensitive customer payment data stored in the transaction database is exposed due to SQL injection or misconfiguration.",
                  "mitigation": "Encrypt sensitive data at rest using AES-256. Use parameterised queries. Apply least-privilege database access. Reference OWASP Top 10 A02.",
                  "modelType": "STRIDE"
                }
              ]
            }
          },
