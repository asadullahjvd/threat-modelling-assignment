              "description": "Third-party email delivery service for order confirmation emails",
              "outOfScope": false,
              "threats": [
                {
                  "id": "threat-6",
                  "title": "Email Service Compromise for Phishing",
                  "type": "Elevation of privilege",
                  "status": "Open",
                  "severity": "High",
                  "description": "An attacker compromises the email service API key, sending fraudulent order confirmation emails with phishing links to customers.",
                  "mitigation": "Use dedicated send-only API keys. Implement DKIM, SPF, and DMARC. Monitor for anomalous sending patterns.",
                  "modelType": "STRIDE"
                }
              ]
            }
