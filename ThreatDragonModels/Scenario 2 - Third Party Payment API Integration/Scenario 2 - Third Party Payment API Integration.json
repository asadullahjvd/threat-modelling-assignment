            "data": {
              "type": "tm.Store",
              "name": "Transaction Database",
              "description": "Internal database storing transaction results, order details, and customer information",
              "outOfScope": false,
              "isALog": false,
              "storesCredentials": false,
              "isEncrypted": false,
              "threats": [
                {
                  "id": "threat-5",
                  "title": "Customer Payment Data Exposure",
                  "type": "Information disclosure",
                  "status": "Open",
                  "severity": "High",
                  "description": "Sensitive customer payment and personal data stored in the transaction database is exposed due to SQL injection, misconfiguration, or unauthorised access.",
                  "mitigation": "Encrypt sensitive data at rest using AES-256. Use parameterised queries to prevent SQL injection. Apply least-privilege database access controls. Reference OWASP Top 10 A02.",
                  "modelType": "STRIDE"
                }
              ]
            }
          },
