          {
            "type": "tm.Process",
            "size": { "width": 100, "height": 100 },
            "position": { "x": 180, "y": 280 },
            "attrs": { "text": { "text": "Patient Portal" } },
            "shape": "process",
            "id": "process-portal",
            "zIndex": 4,
            "data": {
              "type": "tm.Process",
              "name": "Patient Portal",
              "description": "Web frontend exposed to the public internet for patients to access records and book appointments",
              "outOfScope": false,
              "threats": [
                {
                  "id": "threat-1",
                  "title": "Cross-Site Scripting on Patient Portal",
                  "type": "Tampering",
                  "status": "Open",
                  "severity": "High",
                  "description": "Attacker injects malicious scripts into the patient portal to steal session tokens or patient health data.",
                  "mitigation": "Implement strict Content Security Policy, sanitise all inputs, apply output encoding. Reference OWASP Top 10 A03:2021.",
                  "modelType": "STRIDE"
                },
                {
                  "id": "threat-2",
                  "title": "Patient Portal DDoS Attack",
                  "type": "Denial of service",
                  "status": "Open",
                  "severity": "High",
                  "description": "Attacker floods the patient portal preventing legitimate patients from accessing medical records and appointments.",
                  "mitigation": "Deploy WAF, implement rate limiting, use CDN with DDoS protection. Reference NIST 800-53 SC-5.",
                  "modelType": "STRIDE"
                }
              ]
            }
          },
          {
            "type": "tm.Process",
            "size": { "width": 100, "height": 100 },
            "position": { "x": 380, "y": 160 },
            "attrs": { "text": { "text": "API Gateway" } },
            "shape": "process",
            "id": "process-gateway",
            "zIndex": 4,
            "data": {
              "type": "tm.Process",
              "name": "API Gateway",
              "description": "Routes all inbound requests to appropriate backend microservices. Exposed to public internet.",
              "outOfScope": false,
              "threats": [
                {
                  "id": "threat-3",
                  "title": "API Gateway DDoS",
                  "type": "Denial of service",
                  "status": "Open",
                  "severity": "High",
                  "description": "Attacker overwhelms the API Gateway causing outage across all internal microservices.",
                  "mitigation": "Implement rate limiting per client, use throttling policies, deploy behind load balancer with DDoS mitigation. Reference NIST 800-53 SC-5.",
                  "modelType": "STRIDE"
                },
                {
                  "id": "threat-4",
                  "title": "Sensitive PHI Exposure via API Response",
                  "type": "Information disclosure",
                  "status": "Open",
                  "severity": "Critical",
                  "description": "API gateway returns excessive patient health information in responses without field-level filtering.",
                  "mitigation": "Implement response filtering at API gateway level. Apply field-level access control. Encrypt all data in transit with TLS 1.3. Reference OWASP Top 10 A02 and HIPAA.",
                  "modelType": "STRIDE"
                }
              ]
            }
          },
          {
            "type": "tm.Process",
            "size": { "width": 100, "height": 100 },
            "position": { "x": 390, "y": 280 },
            "attrs": { "text": { "text": "Identity Service" } },
            "shape": "process",
            "id": "process-identity",
            "zIndex": 4,
            "data": {
              "type": "tm.Process",
              "name": "Identity Service",
              "description": "Handles authentication and authorisation using OAuth 2.0 and issues JWTs",
              "outOfScope": false,
              "threats": [
                {
                  "id": "threat-5",
                  "title": "JWT Forgery Attack",
                  "type": "Spoofing",
                  "status": "Open",
                  "severity": "Critical",
                  "description": "Attacker forges a JWT using a weak signing secret or none algorithm vulnerability to access other patients records.",
                  "mitigation": "Use asymmetric signing keys RS256. Validate algorithm strictly rejecting none. Implement short token expiry. Reference OWASP JWT Security Cheat Sheet.",
                  "modelType": "STRIDE"
                },
                {
                  "id": "threat-6",
                  "title": "Broken OAuth Scope - Privilege Escalation",
                  "type": "Elevation of privilege",
                  "status": "Open",
                  "severity": "Critical",
                  "description": "Attacker manipulates OAuth 2.0 scope parameters to obtain tokens with broader permissions gaining access to admin or other patient records.",
                  "mitigation": "Strictly validate and enforce OAuth scopes server-side. Implement least-privilege token issuance. Reference OWASP Top 10 A01:2021.",
                  "modelType": "STRIDE"
                },
                {
                  "id": "threat-7",
                  "title": "JWT Not Expiring - Session Persistence",
                  "type": "Elevation of privilege",
                  "status": "Open",
                  "severity": "High",
                  "description": "JWTs without short expiry remain valid indefinitely allowing a stolen token to be reused long after the legitimate session ended.",
                  "mitigation": "Set short JWT expiry of 15 minutes. Implement refresh token rotation. Maintain token revocation list. Reference NIST 800-53 IA-11.",
                  "modelType": "STRIDE"
                }
              ]
            }
          },
          {
            "type": "tm.Process",
            "size": { "width": 100, "height": 100 },
            "position": { "x": 580, "y": 280 },
            "attrs": { "text": { "text": "Medical Records Service" } },
            "shape": "process",
            "id": "process-records",
            "zIndex": 4,
            "data": {
              "type": "tm.Process",
              "name": "Medical Records Service",
              "description": "Stores and retrieves patient medical records. Verifies JWTs with Identity Service.",
              "outOfScope": false,
              "threats": [
                {
                  "id": "threat-8",
                  "title": "Unauthorised Medical Record Tampering",
                  "type": "Tampering",
                  "status": "Open",
                  "severity": "Critical",
                  "description": "Attacker with stolen or forged JWT modifies patient medical records including diagnoses and medications directly harming patient safety.",
                  "mitigation": "Implement record-level integrity checks using cryptographic hashing. Enforce separate write permissions. Maintain immutable audit logs. Reference ISO 27001 A.14.1.",
                  "modelType": "STRIDE"
                },
                {
                  "id": "threat-9",
                  "title": "Audit Log Deletion",
                  "type": "Repudiation",
                  "status": "Open",
                  "severity": "High",
                  "description": "An attacker deletes or alters audit logs to remove evidence of unauthorised record access or modifications.",
                  "mitigation": "Store audit logs in write-once append-only tamper-evident system. Use separate logging service with restricted delete permissions. Reference NIST 800-53 AU-9.",
                  "modelType": "STRIDE"
                }
              ]
            }
          },
          {
            "type": "tm.Process",
            "size": { "width": 100, "height": 100 },
            "position": { "x": 390, "y": 400 },
            "attrs": { "text": { "text": "Appointment Service" } },
            "shape": "process",
            "id": "process-appointment",
            "zIndex": 4,
            "data": {
              "type": "tm.Process",
              "name": "Appointment Service",
              "description": "Manages appointment scheduling. Reads patient data from Medical Records Service.",
              "outOfScope": false,
              "threats": [
                {
                  "id": "threat-10",
                  "title": "Inter-Service Data Tampering",
                  "type": "Tampering",
                  "status": "Open",
                  "severity": "High",
                  "description": "Attacker on internal network intercepts and modifies data between Appointment Service and Medical Records Service.",
                  "mitigation": "Implement mutual TLS for all inter-service communication. Use service mesh with identity verification. Reference NIST 800-53 SC-8.",
                  "modelType": "STRIDE"
                }
              ]
            }
          },
          {
            "type": "tm.Process",
            "size": { "width": 100, "height": 100 },
            "position": { "x": 580, "y": 400 },
            "attrs": { "text": { "text": "Notification Service" } },
            "shape": "process",
            "id": "process-notification",
            "zIndex": 4,
            "data": {
              "type": "tm.Process",
              "name": "Notification Service",
              "description": "Sends appointment reminders via SMS and email using third-party providers",
              "outOfScope": false,
              "threats": [
                {
                  "id": "threat-11",
                  "title": "Sensitive Data in Notification Logs",
                  "type": "Information disclosure",
                  "status": "Open",
                  "severity": "High",
                  "description": "Notification service logs full message content including patient names and health information accessible to unauthorised staff.",
                  "mitigation": "Implement log redaction to remove PHI. Apply data minimisation. Encrypt log storage. Reference HIPAA and ISO 27001 A.12.4.",
                  "modelType": "STRIDE"
                },
                {
                  "id": "threat-12",
                  "title": "Spoofed Notification Service",
                  "type": "Spoofing",
                  "status": "Open",
                  "severity": "High",
                  "description": "Attacker deploys rogue notification service impersonating the legitimate service to intercept appointment data or send fraudulent messages.",
                  "mitigation": "Implement service-to-service authentication using mutual TLS. Validate service certificates. Reference NIST 800-53 IA-3.",
                  "modelType": "STRIDE"
                }
              ]
            }
          },
