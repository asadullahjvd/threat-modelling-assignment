          {
            "type": "tm.Process",
            "size": { "width": 100, "height": 100 },
            "position": { "x": 370, "y": 180 },
            "attrs": {
              "text": { "text": "Web Server" }
            },
            "shape": "process",
            "id": "process-webserver",
            "zIndex": 2,
            "data": {
              "type": "tm.Process",
              "name": "Web Server",
              "description": "Handles incoming HTTPS login requests and forwards to session manager",
              "outOfScope": false,
              "threats": [
                {
                  "id": "threat-1",
                  "title": "Credential Stuffing Attack",
                  "type": "Spoofing",
                  "status": "Open",
                  "severity": "High",
                  "description": "An attacker uses leaked username and password combinations from other breaches to attempt login, impersonating legitimate users.",
                  "mitigation": "Implement rate limiting, account lockout after failed attempts, and CAPTCHA on the login endpoint.",
                  "modelType": "STRIDE"
                },
                {
                  "id": "threat-2",
                  "title": "Login Endpoint Denial of Service",
                  "type": "Denial of service",
                  "status": "Open",
                  "severity": "Medium",
                  "description": "An attacker floods the login endpoint with requests making the web server unresponsive to legitimate users.",
                  "mitigation": "Apply rate limiting per IP, use a Web Application Firewall, and implement CAPTCHA.",
                  "modelType": "STRIDE"
                }
              ]
            }
          },
          {
            "type": "tm.Process",
            "size": { "width": 100, "height": 100 },
            "position": { "x": 620, "y": 180 },
            "attrs": {
              "text": { "text": "Session Manager" }
            },
            "shape": "process",
            "id": "process-session",
            "zIndex": 2,
            "data": {
              "type": "tm.Process",
              "name": "Session Manager",
              "description": "Generates and validates session tokens after successful authentication",
              "outOfScope": false,
              "threats": [
                {
                  "id": "threat-3",
                  "title": "Session Token Hijacking",
                  "type": "Tampering",
                  "status": "Open",
                  "severity": "High",
                  "description": "An attacker intercepts or steals a valid session token through network sniffing or XSS, then uses it to impersonate the authenticated user.",
                  "mitigation": "Set HttpOnly and Secure cookie flags. Regenerate tokens after login. Implement session timeout.",
                  "modelType": "STRIDE"
                }
              ]
            }
          },
          {
            "type": "tm.Store",
            "size": { "width": 120, "height": 60 },
            "position": { "x": 610, "y": 350 },
            "attrs": {
              "text": { "text": "User Database" }
            },
            "shape": "store",
            "id": "store-db",
            "zIndex": 2,
            "data": {
              "type": "tm.Store",
              "name": "User Database",
              "description": "Relational database storing usernames and hashed passwords",
              "outOfScope": false,
              "isALog": false,
              "storesCredentials": true,
              "isEncrypted": false,
              "threats": [
                {
                  "id": "threat-4",
                  "title": "Password Database Breach",
                  "type": "Information disclosure",
                  "status": "Open",
                  "severity": "High",
                  "description": "An attacker gains unauthorised access to the user database and retrieves stored credentials.",
                  "mitigation": "Hash passwords with bcrypt or Argon2. Encrypt database at rest. Restrict access to application processes only.",
                  "modelType": "STRIDE"
                }
              ]
            }
          },
