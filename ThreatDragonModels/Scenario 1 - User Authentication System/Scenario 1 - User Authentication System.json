            "id": "process-webserver",
            "zIndex": 2,
            "data": {
              "type": "tm.Process",
              "name": "Web Server",
              "description": "Handles incoming HTTP/HTTPS login requests from the user and forwards to session manager",
              "outOfScope": false,
              "reasonOutOfScope": "",
              "threats": [
                {
                  "id": "threat-1",
                  "title": "Credential Stuffing Attack",
                  "type": "Spoofing",
                  "status": "Open",
                  "severity": "High",
                  "description": "An attacker uses leaked username and password combinations from other breaches to attempt login to the web application, impersonating legitimate users.",
                  "mitigation": "Implement rate limiting, account lockout after failed attempts, and CAPTCHA on the login endpoint. Use breach password detection services.",
                  "modelType": "STRIDE"
                },
                {
                  "id": "threat-2",
                  "title": "Login Endpoint Denial of Service",
                  "type": "Denial of service",
                  "status": "Open",
                  "severity": "Medium",
                  "description": "An attacker floods the login endpoint with a large volume of requests, making the web server unresponsive to legitimate users.",
                  "mitigation": "Apply rate limiting per IP address, use a Web Application Firewall (WAF), and implement CAPTCHA to distinguish bots from humans.",
                  "modelType": "STRIDE"
                }
              ]
            }
          },
          {
            "type": "tm.Process",
            "size": { "width": 100, "height": 100 },
            "position": { "x": 620, "y": 190 },
            "attrs": {
              "text": { "text": "Session Manager" }
            },
            "shape": "process",
            "id": "process-session",
            "zIndex": 2,
            "data": {
              "type": "tm.Process",
              "name": "Session Manager",
              "description": "Generates and validates session tokens after successful authentication",
              "outOfScope": false,
              "reasonOutOfScope": "",
              "threats": [
                {
                  "id": "threat-3",
                  "title": "Session Token Hijacking",
                  "type": "Tampering",
                  "status": "Open",
                  "severity": "High",
                  "description": "An attacker intercepts or steals a valid session token through network sniffing or XSS, then uses it to impersonate the authenticated user without needing credentials.",
                  "mitigation": "Set session tokens with HttpOnly and Secure cookie flags. Regenerate tokens after login. Implement session timeout and invalidation on logout.",
                  "modelType": "STRIDE"
                }
              ]
            }
          },
          {
            "type": "tm.Store",
            "size": { "width": 120, "height": 60 },
            "position": { "x": 610, "y": 360 },
            "attrs": {
