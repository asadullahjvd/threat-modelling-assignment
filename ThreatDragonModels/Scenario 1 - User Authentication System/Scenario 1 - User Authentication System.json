            },
            "shape": "store",
            "id": "store-db",
            "zIndex": 2,
            "data": {
              "type": "tm.Store",
              "name": "User Database",
              "description": "Relational database storing user credentials including usernames and hashed passwords",
              "outOfScope": false,
              "reasonOutOfScope": "",
              "isALog": false,
              "storesCredentials": true,
              "isEncrypted": false,
              "threats": [
                {
                  "id": "threat-4",
                  "title": "Password Database Breach",
                  "type": "Information disclosure",
                  "status": "Open",
                  "severity": "High",
                  "description": "An attacker gains unauthorised access to the user database and retrieves stored credentials. If passwords are stored in plaintext or weakly hashed, they can be cracked and used.",
                  "mitigation": "Store passwords using strong hashing algorithms such as bcrypt or Argon2 with salting. Encrypt the database at rest and restrict database access to application processes only.",
                  "modelType": "STRIDE"
                }
              ]
            }
          },
